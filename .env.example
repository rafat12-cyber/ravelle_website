# Copy to .env and fill in. Never commit .env.
PORT=3000
# The address customers use, used for SSLCOMMERZ return links
PUBLIC_URL=https://ravellebd.com
# Where db.json, backups and uploads are stored
DATA_DIR=data
# First admin account (only used when the store has no users yet)
ADMIN_EMAIL=admin@ravellebd.com
ADMIN_PASSWORD=change-this-password
# SSLCOMMERZ merchant credentials (sandbox or live, set in Admin → Settings → Payments)
SSLC_STORE_ID=
SSLC_STORE_PASSWORD=
# Set to 1 only when the store sits behind your own proxy (nginx, Caddy, cPanel Node app, Cloudflare).
# Then rate limits use the visitor's real address. Leave empty when Node faces the internet directly,
# or anyone could fake their address and skip the login and order limits.
TRUST_PROXY=
# Admin sign-in only works at PUBLIC_URL/admin when PUBLIC_URL is https. Set to 0 only to test on another address.
ADMIN_LOCK=
